#!/usr/bin/env bash
set -euo pipefail
# This same file can be copied to the global bin directory. No resolution subshells.
if [ -z "${T3_THREAD_REPO:-}" ]; then
  if [ -f "${BASH_SOURCE[0]%/*}/../scripts/launch.mjs" ]; then
    T3_THREAD_REPO="${BASH_SOURCE[0]%/*}/.."
  else
    for candidate in "$HOME/.local/share/t3-thread/current/apps/t3-thread" "$HOME/Programming/t3code-fork/apps/t3-thread" "$HOME/Programming/t3-plugin/apps/t3-thread"; do
      if [ -d "$candidate" ]; then T3_THREAD_REPO="$candidate"; break; fi
    done
  fi
fi
if [ -z "${T3_THREAD_REPO:-}" ] || [ ! -f "$T3_THREAD_REPO/package.json" ]; then
  echo "t3-thread: workspace missing; set T3_THREAD_REPO to apps/t3-thread." >&2
  exit 1
fi
cd "$T3_THREAD_REPO"
if [ -n "${T3_THREAD_NODE_BIN:-}" ]; then export PATH="$T3_THREAD_NODE_BIN:$PATH"; fi
if [ "${T3_THREAD_DEV:-0}" = 1 ]; then
  exec ./node_modules/.bin/tsx src/cli.ts "$@"
fi
if [ ! -f scripts/launch.mjs ]; then
  echo "t3-thread: prebuilt launcher missing; deploy a reviewed snapshot with build support, or explicitly use T3_THREAD_DEV=1." >&2
  exit 1
fi
exec node scripts/launch.mjs "$@"
