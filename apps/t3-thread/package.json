{
  "name": "t3-thread",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "t3-thread": "dist/cli.cjs",
    "t3-agent": "dist/cli.cjs"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=dist/cli.cjs",
    "cli": "tsx src/cli.ts",
    "smoke": "tsx src/cli.ts envs >/dev/null && tsx src/cli.ts projects --env local-mbp >/dev/null && tsx src/cli.ts watch --once --no-deliver >/dev/null",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "commander": "^14.0.3",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "description": "Operator CLI for T3 Code worker threads",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jimprince/t3code.git",
    "directory": "apps/t3-thread"
  }
}
