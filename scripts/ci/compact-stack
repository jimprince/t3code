#!/usr/bin/env bash

set -euo pipefail

# Rebuilds the fork's patch stack as a small set of curated topic commits.
#
# Topic commits are built from the FINAL tree state by path, not by reordering
# history. That makes the resulting tree identical by construction, which the
# tree-identity gate then proves. Reordering 120 commits interactively is both
# error-prone and unnecessary.
#
# Required env:
#   COMPACT_BASE    merge-base sha to build on top of
#   COMPACT_SOURCE  branch holding the current fork work
#   COMPACT_TARGET  branch to create
# Optional env:
#   COMPACT_TOPICS  path to topics JSON (default scripts/ci/fork-topics.json)
#   SYNC_GIT_BIN    git binary path
#
# Topics JSON: [{ "message": "fork: tooling", "paths": ["tools/", "a/b.ts"] }]
# A path ending in "/" matches by prefix; otherwise it matches exactly.
#
# This script runs from a committed checkout and checks out COMPACT_BASE's
# tree partway through (see `checkout -q -B "$COMPACT_TARGET" "$COMPACT_BASE"`
# below), which can remove scripts/ci/ -- including this file -- from the
# worktree if COMPACT_BASE predates it. Verified experimentally that this does
# NOT break execution: Unix keeps an unlinked file's inode reachable through
# the shell's already-open file descriptor, so bash keeps reading and running
# the rest of this script fine even after its own path is gone from the
# worktree. The topics JSON does not get the same protection for free -- it is
# read by separate `node` invocations that open it by path each time -- which
# is why it is snapshotted into $workdir before that checkout below.

: "${COMPACT_BASE:?COMPACT_BASE is required}"
: "${COMPACT_SOURCE:?COMPACT_SOURCE is required}"
: "${COMPACT_TARGET:?COMPACT_TARGET is required}"

TOPICS_FILE_ARG="${COMPACT_TOPICS:-scripts/ci/fork-topics.json}"

GIT_BIN="${SYNC_GIT_BIN:-$(command -v git)}"
git_cmd() {
  "$GIT_BIN" "$@"
}

# Resolve COMPACT_SOURCE to a fixed SHA immediately. If it's a relative ref
# like "HEAD" (as the real dry run uses), it must not be allowed to drift once
# we check out COMPACT_TARGET below -- otherwise "HEAD" starts pointing at the
# newly created target branch instead of the original source commit, and every
# later `checkout "$COMPACT_SOURCE" -- <path>` silently reads the wrong tree.
COMPACT_SOURCE="$(git_cmd rev-parse "$COMPACT_SOURCE")"

# Refuse to let COMPACT_TARGET name a protected branch. `checkout -q -B` below
# is a hard reset of whatever ref COMPACT_TARGET names -- if that happens to
# be main, master, or the branch currently checked out (typo, stale env,
# copy-paste from the wrong terminal), the real branch gets force-reset to
# COMPACT_BASE before a single gate has run, right before the step that
# force-pushes the result.
current_branch="$(git_cmd rev-parse --abbrev-ref HEAD)"
for protected in main master "$current_branch"; do
  if [[ "$COMPACT_TARGET" == "$protected" ]]; then
    echo "Refusing to use protected branch '$COMPACT_TARGET' as COMPACT_TARGET." >&2
    exit 1
  fi
done

# Remember exactly where the operator started -- a branch name if HEAD was on
# one, otherwise the bare commit it was detached at -- so the trap below can
# always put them back. Two prior incidents: this script used to leave HEAD
# checked out on COMPACT_TARGET, and the operator ran later commands
# believing they were still on their original branch.
START_REF="$(git_cmd symbolic-ref --quiet --short HEAD || true)"
if [[ -z "$START_REF" ]]; then
  START_REF="$(git_cmd rev-parse HEAD)"
fi
render_landed_on=""

workdir="$(mktemp -d)"
restore_start_ref() {
  local exit_code=$?
  /bin/rm -rf "$workdir"

  if [[ -n "$render_landed_on" ]]; then
    echo "" >&2
    echo "Render landed on branch '$render_landed_on'." >&2
    echo "  Inspect it with:" >&2
    echo "    git log $render_landed_on" >&2
    echo "    git diff $COMPACT_SOURCE $render_landed_on" >&2
  fi
  echo "Restoring HEAD to '$START_REF' (where this script started)." >&2
  git_cmd checkout -q "$START_REF"

  exit "$exit_code"
}
trap restore_start_ref EXIT

changed="$workdir/changed.txt"
covered="$workdir/covered.txt"

# Snapshot the topics JSON into $workdir BEFORE the checkout -B below, and use
# only this copy from here on. COMPACT_TOPICS defaults to a path inside the
# repo (scripts/ci/fork-topics.json), which is only guaranteed to exist in
# COMPACT_SOURCE's tree, not in COMPACT_BASE's. `checkout -q -B "$COMPACT_TARGET"
# "$COMPACT_BASE"` below switches the worktree to COMPACT_BASE's tree; if the
# topics file was added to the repo after COMPACT_BASE (which is exactly the
# fork-maintenance case -- these files did not exist before this task), that
# checkout deletes it out from under the rest of the script, and the very
# next read of it dies with ENOENT, leaving HEAD on a half-built branch at
# COMPACT_BASE with no topics file and no clean way back. Reading it into
# $workdir first means the rest of the script never touches the repo path
# again, regardless of what checkout does to the worktree.
TOPICS_FILE="$workdir/topics.json"
if [[ ! -f "$TOPICS_FILE_ARG" ]]; then
  echo "Topics file not found: $TOPICS_FILE_ARG" >&2
  exit 1
fi
cp "$TOPICS_FILE_ARG" "$TOPICS_FILE"

# --no-renames matters: git's default rename detection collapses a
# delete-old-path + add-new-path pair into a single entry that shows only the
# new path, which would silently drop the old path from the changed-file set
# entirely (it never appears as "uncovered" or "double-claimed" -- it just
# vanishes). That hides real content from both gates. Diffing without rename
# detection keeps the delete and the add as two explicit entries so the old
# path still has to be claimed by a topic and explicitly removed below.
git_cmd diff --no-renames --name-only "$COMPACT_BASE" "$COMPACT_SOURCE" | sort > "$changed"

# Gate 2a: every changed path must be claimed by exactly one topic. Run this
# BEFORE mutating any refs so a bad topics file cannot leave a half-built branch.
node --input-type=module -e '
import { readFileSync } from "node:fs";

const [topicsFile, changedFile] = process.argv.slice(1);
const topics = JSON.parse(readFileSync(topicsFile, "utf8"));
const changed = readFileSync(changedFile, "utf8").split("\n").filter(Boolean);

const matches = (file, pattern) =>
  pattern.endsWith("/") ? file.startsWith(pattern) : file === pattern;

const uncovered = [];
const duplicated = [];
for (const file of changed) {
  const owners = topics.filter((topic) => topic.paths.some((p) => matches(file, p)));
  if (owners.length === 0) uncovered.push(file);
  if (owners.length > 1) duplicated.push(`${file} -> ${owners.map((o) => o.message).join(", ")}`);
}

if (uncovered.length > 0) {
  console.error("Path coverage gate FAILED. Files not covered by any topic:");
  for (const file of uncovered) console.error(`  ${file}`);
}
if (duplicated.length > 0) {
  console.error("Path coverage gate FAILED. Files claimed by multiple topics:");
  for (const entry of duplicated) console.error(`  ${entry}`);
}
process.exit(uncovered.length + duplicated.length > 0 ? 1 : 0);
' "$TOPICS_FILE" "$changed"

# Gate 2c (freshness): refuse to render from a stale source. Run this BEFORE
# mutating any refs, for the same reason as gate 2a above.
#
# The tree-identity gate near the bottom of this script proves the rendered
# COMPACT_TARGET is byte-identical to COMPACT_SOURCE. It says NOTHING about
# whether COMPACT_SOURCE itself was current. This is exactly what caused a
# real incident: an operator ran this script against a COMPACT_SOURCE built
# on a local `main` that was five days and one `sync-upstream` behind the
# real origin/main. The render was internally perfect -- tree-identity
# passed, byte-identical to its source -- and force-pushing it silently
# discarded 60 files of fork work that existed only on origin/main. A
# correct rendering of a stale source is still a data-loss event.
#
# This gate fetches origin/main itself rather than trusting whatever the
# local origin/main remote-tracking ref happens to say -- an operator who
# forgot to fetch is exactly the person this is meant to protect.
if ! git_cmd remote get-url origin >/dev/null 2>&1; then
  echo "Freshness gate SKIPPED: no 'origin' remote configured (standalone repo)." >&2
elif [[ "${COMPACT_ALLOW_STALE:-}" == "1" ]]; then
  echo "############################################################" >&2
  echo "# COMPACT_ALLOW_STALE=1 is set: SKIPPING the freshness gate." >&2
  echo "# This is the exact condition that previously caused 60      " >&2
  echo "# files of fork work to be silently discarded by a force-push" >&2
  echo "# of a byte-identical-but-stale render. Only proceed if you   " >&2
  echo "# have manually confirmed COMPACT_SOURCE already contains     " >&2
  echo "# everything on origin/main.                                  " >&2
  echo "############################################################" >&2
else
  echo "Freshness gate: fetching origin main..." >&2
  git_cmd fetch origin main
  origin_main_sha="$(git_cmd rev-parse FETCH_HEAD)"
  if ! git_cmd merge-base --is-ancestor "$origin_main_sha" "$COMPACT_SOURCE"; then
    missing_count="$(git_cmd rev-list --count "${COMPACT_SOURCE}..${origin_main_sha}")"
    echo "Freshness gate FAILED: COMPACT_SOURCE does not contain the current origin/main." >&2
    echo "  COMPACT_SOURCE: $COMPACT_SOURCE" >&2
    echo "  origin/main:    $origin_main_sha" >&2
    echo "  origin/main has $missing_count commit(s) that COMPACT_SOURCE lacks." >&2
    echo "  Rebase COMPACT_SOURCE onto origin/main and re-run." >&2
    exit 1
  fi
  echo "Freshness gate: PASS (origin/main is an ancestor of COMPACT_SOURCE)." >&2
fi

git_cmd checkout -q -B "$COMPACT_TARGET" "$COMPACT_BASE"
render_landed_on="$COMPACT_TARGET"

topic_count="$(node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).length)' "$TOPICS_FILE")"

for ((index = 0; index < topic_count; index++)); do
  message="$(node -e 'const t=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));console.log(t[Number(process.argv[2])].message)' "$TOPICS_FILE" "$index")"

  # Portable equivalent of `mapfile -t`: the system /bin/bash on macOS is 3.2,
  # which predates the mapfile builtin (bash 4+), so build the array by hand.
  topic_files=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && topic_files+=("$line")
  done < <(node --input-type=module -e '
    import { readFileSync } from "node:fs";
    const [topicsFile, changedFile, indexRaw] = process.argv.slice(1);
    const topic = JSON.parse(readFileSync(topicsFile, "utf8"))[Number(indexRaw)];
    const changed = readFileSync(changedFile, "utf8").split("\n").filter(Boolean);
    const matches = (file, pattern) =>
      pattern.endsWith("/") ? file.startsWith(pattern) : file === pattern;
    for (const file of changed) {
      if (topic.paths.some((p) => matches(file, p))) console.log(file);
    }
  ' "$TOPICS_FILE" "$changed" "$index")

  if [[ ${#topic_files[@]} -eq 0 ]]; then
    echo "Topic '$message' matched no changed files; skipping."
    continue
  fi

  # Split this topic's files into those that still exist at COMPACT_SOURCE
  # (checkout restores/adds them) and those that don't (the fork deleted
  # them, possibly as the old half of a rename -- git rm removes them from
  # the target). `git checkout <src> -- <paths...>` fails its ENTIRE
  # invocation, touching nothing, if even one pathspec is missing from
  # <src>, so these two groups must be applied separately.
  present_files=()
  absent_files=()
  for topic_file in "${topic_files[@]}"; do
    if git_cmd cat-file -e "${COMPACT_SOURCE}:${topic_file}" 2>/dev/null; then
      present_files+=("$topic_file")
    else
      absent_files+=("$topic_file")
    fi
  done

  if [[ ${#present_files[@]} -gt 0 ]]; then
    git_cmd checkout "$COMPACT_SOURCE" -- "${present_files[@]}"
    git_cmd add -A -- "${present_files[@]}"
  fi
  if [[ ${#absent_files[@]} -gt 0 ]]; then
    git_cmd rm -q -f --ignore-unmatch -- "${absent_files[@]}"
  fi

  if git_cmd diff --cached --quiet; then
    echo "Topic '$message' produced no change; skipping."
    continue
  fi
  git_cmd commit -q -m "$message"
  echo "Created topic: $message (${#topic_files[@]} files)"
done

# Gate 1: tree identity. This is the load-bearing safety check -- capture
# git's actual exit status explicitly. `[[ -n "$(cmd)" ]]` alone treats a
# command that FAILED (bad ref, corrupt object, git crash) identically to a
# command that succeeded and printed nothing: both read as an empty string,
# which this gate would then read as PASS. That is a vacuous pass on exactly
# the check the rest of this project depends on.
set +e
tree_diff="$(git_cmd diff "$COMPACT_SOURCE" "$COMPACT_TARGET")"
tree_diff_status=$?
set -e
if [[ "$tree_diff_status" -ne 0 ]]; then
  echo "Tree identity gate FAILED: git diff exited $tree_diff_status -- treating as failure, not a vacuous pass" >&2
  exit 1
fi
if [[ -n "$tree_diff" ]]; then
  echo "Tree identity gate FAILED: $COMPACT_TARGET differs from $COMPACT_SOURCE" >&2
  git_cmd diff --stat "$COMPACT_SOURCE" "$COMPACT_TARGET" >&2
  exit 1
fi

# Gate 2b: the compacted branch must change exactly the same files.
git_cmd diff --no-renames --name-only "$COMPACT_BASE" "$COMPACT_TARGET" | sort > "$covered"
if ! diff -q "$changed" "$covered" >/dev/null; then
  echo "Path coverage gate FAILED: changed-file sets differ" >&2
  diff "$changed" "$covered" >&2 || true
  exit 1
fi

echo "Compaction complete."
echo "  $COMPACT_SOURCE: $(git_cmd rev-list --count "${COMPACT_BASE}..${COMPACT_SOURCE}") commits"
echo "  $COMPACT_TARGET: $(git_cmd rev-list --count "${COMPACT_BASE}..${COMPACT_TARGET}") commits"
echo "  Tree identity: PASS"
echo "  Path coverage: PASS"
