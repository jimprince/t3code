#!/usr/bin/env bash
set -euo pipefail

# Publish verification inputs only. Canonical main/stack/tag publication still
# belongs to publish-stgit-stack and its immutable preparation-time leases.
remote="${STGIT_REMOTE:-origin}"
head="$(git rev-parse HEAD)"
stack="$(git rev-parse refs/stacks/stgit/adopt)"
branch_ref="refs/heads/ci-candidate/$head"
stack_ref="refs/ci-stacks/$head"
if [[ -n "$(git status --porcelain)" ]]; then
  echo 'Candidate staging requires a clean checkout.' >&2
  exit 1
fi
if [[ "$(git show "$stack:stack.json" | bun -e 'console.log((await Bun.stdin.json()).head)')" != "$head" ]]; then
  echo 'Candidate metadata does not describe HEAD.' >&2
  exit 1
fi
expected="$(printf '%s\t%s\n%s\t%s\n' "$head" "$branch_ref" "$stack" "$stack_ref" | sort)"
observed="$(git ls-remote --refs "$remote" "$branch_ref" "$stack_ref" | sort)"
if [[ -n "$observed" && "$observed" != "$expected" ]]; then
  echo 'Immutable candidate refs already exist with different or incomplete state.' >&2
  exit 1
fi
if [[ -z "$observed" ]]; then
  git push --atomic \
    "--force-with-lease=$branch_ref:" "--force-with-lease=$stack_ref:" \
    "$remote" "$head:$branch_ref" "$stack:$stack_ref"
fi
if [[ "$(git ls-remote --refs "$remote" "$branch_ref" "$stack_ref" | sort)" != "$expected" ]]; then
  echo 'Candidate ref readback did not match.' >&2
  exit 1
fi
echo "Candidate ready for CI: ci-candidate/$head"
